#!/usr/bin/env python3
"""Nightly system-change snapshot + grounded model analysis.

~/.hermes is a LOCAL-ONLY git repo (no remote; secrets gitignored) used purely
as a change ledger. Each night at 3:05a this script:

  1. commits the day's changes ("auto: system snapshot ...")
  2. builds the last-24h diff, plus the ~/hermes-setup build-docs delta
  3. has the agent model (headless `hermes -z`, Codex OAuth) write a SHORT
     what-changed / what-we-built summary — HARD-GROUNDED: it may only restate
     what the diff shows; anything uncertain is omitted, and the raw diffstat
     is always rendered alongside it in the digest as the checkable truth
  4. writes the artifacts the 8:10a ops digest embeds:
       ~/.hermes/logs/system-changes.meta.json   (deterministic facts)
       ~/.hermes/logs/system-changes.html        (narrative fragment, may be empty)

Runs BEFORE the 3:15a backup so the snapshot commit rides the encrypted bundle.
Smoke-test:  python system_changes.py
"""
import datetime
import html
import json
import os
import re
import subprocess
from pathlib import Path

HOME = Path.home()
GIT = "/usr/bin/git"
LEDGER = str(HOME / ".hermes")
SETUP = str(HOME / "{{DOCS_REPO_DIR}}")
LOGS = HOME / ".hermes" / "logs"
HERMES = str(HOME / ".hermes/hermes-agent/venv/bin/hermes")
META = LOGS / "system-changes.meta.json"
HTMLF = LOGS / "system-changes.html"
DIFF_CAP = 12000  # chars of raw diff handed to the model

# --- weekly built-in-memory content audit (Mondays, riding this job) ---
MEMORIES = HOME / ".hermes" / "memories"
SOUL = HOME / ".hermes" / "SOUL.md"
CONFIG = HOME / ".hermes" / "config.yaml"
AUDIT_META = LOGS / "memory-audit.meta.json"
AUDIT_HTML = LOGS / "memory-audit.html"


def log(msg):
    print(f"[{datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')}] {msg}", flush=True)


def git(repo, *args):
    r = subprocess.run([GIT, "-C", repo, *args], capture_output=True, text=True)
    return r.returncode, r.stdout.strip()


def snapshot():
    """Commit the day's ~/.hermes changes into the ledger. Returns True if committed."""
    git(LEDGER, "add", "-A")
    rc, _ = git(LEDGER, "diff", "--cached", "--quiet")
    if rc == 0:
        return False
    ts = datetime.datetime.now().strftime("%Y-%m-%d %H:%M")
    git(LEDGER, "commit", "-q", "-m", f"auto: system snapshot {ts}")
    return True


def window_base():
    """Newest commit older than 24h — the diff base. Empty string = none (young repo)."""
    _, sha = git(LEDGER, "rev-list", "-1", "--before=24 hours ago", "HEAD")
    return sha


def build_docs_delta():
    """Last-24h delta of ~/hermes-setup: commits + uncommitted working-tree stat."""
    parts = []
    _, commits = git(SETUP, "log", "--since=24 hours ago", "--oneline", "--stat")
    if commits:
        parts.append("build-docs commits (24h):\n" + commits)
    _, wt = git(SETUP, "diff", "--stat")
    if wt:
        parts.append("build-docs uncommitted changes:\n" + wt)
    return "\n\n".join(parts)


def collect(base):
    _, diffstat = git(LEDGER, "diff", "--stat", f"{base}..HEAD")
    _, names = git(LEDGER, "diff", "--name-status", f"{base}..HEAD")
    _, raw = git(LEDGER, "diff", "--unified=1", f"{base}..HEAD")
    m = re.search(r"(\d+) insertion", diffstat)
    ins = int(m.group(1)) if m else 0
    m = re.search(r"(\d+) deletion", diffstat)
    dels = int(m.group(1)) if m else 0
    changed = [ln for ln in names.splitlines() if ln.strip()]
    setup = build_docs_delta()
    if setup:
        diffstat = (diffstat + "\n\n" + setup).strip()
    return {
        "changed_files": len(changed),
        "insertions": ins,
        "deletions": dels,
        "diffstat": diffstat,
        "raw_diff": raw[:DIFF_CAP],
        "setup_delta": setup,
    }


def narrative(facts):
    """Grounded model summary of the diff. Returns HTML fragment or ''."""
    prompt = (
        "You are {{AGENT_NAME}} writing the 'System changes' section of {{OPERATOR_FIRST_NAME}}'s daily ops digest.\n"
        "Below is your ONLY source of truth: the last-24h git changes of the Hermes system "
        "(~/.hermes config, skills, scripts, SOUL, memories) and the build docs.\n\n"
        "HARD RULES — violating any of these makes the output worthless:\n"
        "- Every statement must be directly evidenced by the diff text below.\n"
        "- Do NOT infer intent, speculate, or mention anything absent from the diff.\n"
        "- If a change's purpose isn't evident from the diff content itself, name the "
        "change without ascribing purpose.\n"
        "- Unsure about something? Omit it.\n\n"
        f"=== name-status + diffstat ===\n{facts['diffstat'][:3000]}\n\n"
        f"=== raw diff (capped) ===\n{facts['raw_diff']}\n\n"
        "Write a short HTML fragment (<p>/<ul>/<li>/<strong> only, max ~120 words): "
        "what changed and what got built, in plain operator terms — lead with the most "
        "significant item. Return ONLY the fragment between <!--SYS--> and <!--/SYS--> markers."
    )
    try:
        r = subprocess.run([HERMES, "-z", prompt], capture_output=True, text=True, timeout=300)
        out = r.stdout or ""
    except Exception as e:
        log(f"narrative failed: {e}")
        return ""
    m = re.search(r"<!--SYS-->(.*?)<!--/SYS-->", out, re.S)
    frag = (m.group(1) if m else "").strip()
    frag = re.sub(r"```html|```", "", frag).strip()
    return frag if ("<p" in frag or "<ul" in frag or "<li" in frag) else ""


def _mem_limits():
    """user_char_limit / memory_char_limit from config.yaml (same regex as ops_digest)."""
    txt = CONFIG.read_text() if CONFIG.exists() else ""
    def grab(key, default):
        m = re.search(rf"^\s*{key}:\s*(\d+)", txt, re.M)
        return int(m.group(1)) if m else default
    return grab("user_char_limit", 1375), grab("memory_char_limit", 2200)


_AUDIT_COLORS = {"contradiction": "#dc2626", "redundant": "#d97706",
                 "expired": "#6b7280", "budget": "#7c3aed"}


def _entry_sizes(txt):
    """[(first-6-words label, chars)] per §-entry, largest first."""
    sizes = [(" ".join(e.split()[:6]), len(e))
             for e in (s.strip() for s in txt.split("§")) if e]
    return sorted(sizes, key=lambda t: -t[1])


def _audit_card(kind, title, rows):
    """One finding as a compact card: colored left border, title, labeled detail rows.
    All content is escaped here — model output never reaches the email unescaped."""
    color = _AUDIT_COLORS.get(kind, "#d97706")
    body = "".join(
        f'<div style="font-size:12px;color:#57534e;margin-top:3px">'
        f'<strong>{html.escape(label)}:</strong> {html.escape(text)}</div>'
        for label, text in rows if text)
    return (f'<div style="border-left:3px solid {color};padding:6px 10px;margin:10px 0;'
            f'background:#fafaf9">'
            f'<div style="font-size:13px;font-weight:600">'
            f'<span style="color:{color};font-size:10px;letter-spacing:.05em">'
            f'{html.escape(kind.upper())}</span> {html.escape(title)}</div>{body}</div>')


def memory_audit():
    """Weekly CONTENT audit of built-in memory (USER.md / MEMORY.md) against SOUL.md.
    Flag-only, run from OUTSIDE the agent (an agent can't reliably notice its own
    memory is bad — the broken memory is what it thinks with). The daily ops-digest
    format/drift check stays separate; this one judges content: contradictions,
    entries redundant with a SOUL rule, time-expired entries, near-budget stores.
    Each finding carries its own initial analysis (evidence + assessment + suggested
    fix) so the digest section is actionable without a follow-up investigation.
    Writes memory-audit.html (findings fragment, may be empty) + memory-audit.meta.json.
    Resolution path: the operator decides every fix — via Hermes chat or the backend."""
    today = datetime.datetime.now().strftime("%Y-%m-%d")
    user_limit, mem_limit = _mem_limits()
    cards = []
    texts = {}
    for name, limit in (("USER.md", user_limit), ("MEMORY.md", mem_limit)):
        p = MEMORIES / name
        txt = p.read_text() if p.exists() else ""
        texts[name] = txt
        if txt and len(txt) >= 0.85 * limit:  # deterministic: budget proximity
            biggest = " · ".join(f"“{lbl}…” ({n})" for lbl, n in _entry_sizes(txt)[:5])
            cards.append(_audit_card(
                "budget",
                f"{name} at {len(txt)}/{limit} chars ({len(txt) * 100 // limit}% of budget)",
                [("Largest entries (chars)", biggest),
                 ("Suggested fix", "trim/merge the largest entries, or raise the limit in "
                                   "config.yaml — writes start failing at 100%")]))
    soul = SOUL.read_text() if SOUL.exists() else ""
    llm_ok = False
    if texts["USER.md"] or texts["MEMORY.md"]:
        prompt = (
            "You are auditing an AI agent's two built-in memory files against its standing-rules "
            "file (SOUL.md). Entries are separated by '§'. FLAG ONLY, do not rewrite anything.\n\n"
            "Flag an entry ONLY if it clearly:\n"
            "1. CONTRADICTS another memory entry or a SOUL.md rule (they can't both hold), or\n"
            "2. RESTATES a rule already in SOUL.md (redundant — behavior rules live in SOUL, "
            "memory is for supporting facts; an entry ADDING detail beyond SOUL is fine), or\n"
            "3. IS TIME-EXPIRED (references a date/event now clearly past, framed as upcoming).\n\n"
            f"Today's date: {today}\n\n"
            f"=== SOUL.md ===\n{soul}\n\n"
            f"=== USER.md ===\n{texts['USER.md']}\n\n"
            f"=== MEMORY.md ===\n{texts['MEMORY.md']}\n\n"
            "Return STRICT JSON between <!--MEMAUDIT--> and <!--/MEMAUDIT--> markers, shaped:\n"
            '{"findings": [{"file": "USER.md or MEMORY.md", '
            '"type": "contradiction|redundant|expired", '
            '"quote": "first ~12 words of the flagged entry", '
            '"evidence": "the specific SOUL rule or conflicting entry it clashes with, '
            'quoted (<=30 words)", '
            '"assessment": "1-2 sentences: why it qualifies and what breaks if left in place", '
            '"fix": "one actionable line, e.g. delete the entry / rewrite to keep only X / '
            'promote to SOUL then delete"}]}\n'
            "Use an empty findings list if nothing qualifies. Be conservative — a wrong flag "
            "wastes the operator's time."
        )
        try:
            r = subprocess.run([HERMES, "-z", prompt], capture_output=True, text=True, timeout=300)
            m = re.search(r"<!--MEMAUDIT-->(.*?)<!--/MEMAUDIT-->", r.stdout or "", re.S)
            raw = re.sub(r"```json|```", "", (m.group(1) if m else "")).strip()
            if raw:
                data = json.loads(raw)
                llm_ok = True
                for f in data.get("findings", [])[:8]:
                    cards.append(_audit_card(
                        str(f.get("type") or "flag").lower(),
                        f'{f.get("file", "?")} — “{str(f.get("quote", ""))[:120]}”',
                        [("Evidence", str(f.get("evidence", ""))[:260]),
                         ("Assessment", str(f.get("assessment", ""))[:340]),
                         ("Suggested fix", str(f.get("fix", ""))[:180])]))
        except Exception as e:
            log(f"memory audit LLM step failed: {e}")
    AUDIT_HTML.write_text("".join(cards))
    AUDIT_META.write_text(json.dumps({"date": today, "findings": len(cards), "llm_ok": llm_ok}, indent=2))
    log(f"memory audit: findings={len(cards)} llm_ok={llm_ok}")


def main():
    LOGS.mkdir(parents=True, exist_ok=True)
    committed = snapshot()
    # Monday-only content audit of built-in memory; failure never blocks the ledger job
    if datetime.datetime.now().weekday() == 0 or os.environ.get("FORCE_MEMORY_AUDIT"):
        try:
            memory_audit()
        except Exception as e:
            log(f"memory audit failed: {e}")
            try:
                AUDIT_META.write_text(json.dumps(
                    {"date": datetime.datetime.now().strftime("%Y-%m-%d"), "error": str(e)[:200]}))
            except Exception:
                pass
    base = window_base()
    today = datetime.datetime.now().strftime("%Y-%m-%d")

    if not base:
        _, tracked = git(LEDGER, "ls-files")
        meta = {"date": today, "baseline": True,
                "files_tracked": len(tracked.splitlines()), "changed_files": 0}
        META.write_text(json.dumps(meta, indent=2))
        HTMLF.write_text("")
        log(f"baseline window — {meta['files_tracked']} files tracked; diffs start tomorrow "
            f"(snapshot committed: {committed})")
        return

    facts = collect(base)
    frag = ""
    if facts["changed_files"] or facts["setup_delta"]:
        frag = narrative(facts)
    meta = {"date": today, "baseline": False,
            "changed_files": facts["changed_files"],
            "insertions": facts["insertions"], "deletions": facts["deletions"],
            "diffstat": facts["diffstat"], "narrative_ok": bool(frag)}
    META.write_text(json.dumps(meta, indent=2))
    HTMLF.write_text(frag)
    log(f"snapshot={committed} changed_files={facts['changed_files']} "
        f"+{facts['insertions']}/-{facts['deletions']} narrative={'yes' if frag else 'no'}")


if __name__ == "__main__":
    main()

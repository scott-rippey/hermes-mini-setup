#!/usr/bin/env python3
# TEMPLATE — replace {{PLACEHOLDERS}} from setup/answers.md, save to ~/.hermes/scripts/,
# smoke-test by hand (--dry-run), THEN schedule via templates/launchd/. Placeholder registry: templates/README.md
"""the agent's own inbox watch (hourly launchd poll, `ai.hermes.agent-inbox`).

the agent's mailbox sends as itself (vendor signups, the odd outbound on the operator's say-so) but {{OPERATOR_FIRST_NAME}}
never opens that mailbox, so replies and vendor mail would sit unseen. Every run:
  1. list   — the agent's mailbox's inbox (the SEND token, which carries gmail.readonly for this).
  2. dedupe — message ids already reported (state file, 14-day memory). Nothing new ->
              one log line, no model call, no Slack post. Zero tokens.
  3. read   — subject/from/body of each new message; a thread that already holds a
              message FROM the agent's mailbox is flagged as a reply to something {{AGENT_NAME}} sent.
  4. summarize — ONE agent-model call, 1–2 lines per message, what (if anything) {{OPERATOR_FIRST_NAME}}
              should do. Falls back to the raw subject list if the model step fails.
  5. post   — one Slack message to the home Slack channel (SLACK_HOME_CHANNEL) via `hermes send`.
Read-only on the mailbox; never replies, never sends, never files to the KB.
"""
import datetime
import json
import os
import re
import subprocess
import sys
from email.utils import parseaddr
from pathlib import Path

HOME = Path.home()
HERMES = str(HOME / ".local/bin/hermes")
STATE_FILE = HOME / ".hermes/scripts/.agent_inbox_state.json"
STATE_DAYS = 14
QUERY = "in:inbox newer_than:2d"
MAX_NEW_PER_RUN = 10
BODY_CHARS = 1500
SELF = "{{AGENT_EMAIL}}"

sys.path.insert(0, str(HOME / ".hermes/skills/productivity/google-workspace/scripts"))
import google_api  # noqa: E402

google_api._ACTIVE_ACCOUNT = "send"   # the agent's mailbox's own token (google_token.json)


def log(msg):
    print(f"[{datetime.datetime.now().strftime('%Y-%m-%d %H:%M %Z')}] {msg}", flush=True)


def load_state():
    try:
        return json.loads(STATE_FILE.read_text())
    except Exception:
        return {"seen": {}}


def save_state(state):
    cutoff = (datetime.datetime.now(datetime.timezone.utc)
              - datetime.timedelta(days=STATE_DAYS)).isoformat()
    state["seen"] = {k: v for k, v in state["seen"].items() if v >= cutoff}
    tmp = STATE_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(state, indent=1))
    tmp.replace(STATE_FILE)


def _hdr(msg):
    return {h["name"].lower(): h["value"] for h in msg.get("payload", {}).get("headers", [])}


def _clean(text):
    text = re.sub(r"<[^>]+>", " ", text)
    text = re.sub(r"[ \t]+", " ", text)
    text = re.sub(r"\n\s*\n+", "\n", text)
    return text.strip()


def fetch_new(service, seen):
    listing = service.users().messages().list(userId="me", q=QUERY, maxResults=40).execute()
    ids = [m["id"] for m in listing.get("messages", []) if m["id"] not in seen]
    items = []
    for mid in ids[:MAX_NEW_PER_RUN]:
        msg = service.users().messages().get(userId="me", id=mid, format="full").execute()
        h = _hdr(msg)
        name, email = parseaddr(h.get("from", ""))
        if email.lower() == SELF:
            continue  # its own sent copies landing in inbox (e.g. self-CC) are not news
        th = service.users().threads().get(userId="me", id=msg["threadId"], format="metadata",
                                           metadataHeaders=["From"]).execute()
        sent_by_self = any(parseaddr(_hdr(m).get("from", ""))[1].lower() == SELF
                           for m in th.get("messages", []) if m["id"] != mid)
        items.append({
            "message_id": mid,
            "from_name": name or email,
            "from_email": email,
            "subject": h.get("subject", "(no subject)"),
            "date": h.get("date", ""),
            "reply_to_agent": sent_by_self,
            "body": _clean(google_api._extract_message_body(msg))[:BODY_CHARS] or msg.get("snippet", ""),
        })
    return items


def summarize(items):
    blocks = [
        f"=== MESSAGE {i} ===\nFROM: {it['from_name']} <{it['from_email']}>\nSUBJECT: {it['subject']}\n"
        f"DATE: {it['date']}\nREPLY TO SOMETHING THE AGENT SENT: {'yes' if it['reply_to_agent'] else 'no'}\n\n{it['body']}"
        for i, it in enumerate(items, 1)
    ]
    prompt = (
        "You are {{AGENT_NAME}} reporting on your OWN mailbox (the agent's mailbox) to {{OPERATOR_FIRST_NAME}}, who never opens it. "
        "For EACH message below write ONE line, max 30 words: what it is and whether {{OPERATOR_FIRST_NAME}} needs to do "
        "anything (say 'nothing needed' when that's true — most of this is vendor/account mail). "
        "Never invent facts; use only the message data. Do NOT use any tools.\n\n"
        "Output ONLY a JSON array wrapped EXACTLY between <!--INBOX--> and <!--/INBOX-->, one object per "
        "message in order: {\"n\": <number>, \"line\": \"<the one line>\"}\n\n" + "\n\n".join(blocks)
    )
    env = {**os.environ, "HOME": str(HOME),
           "PATH": "/opt/homebrew/bin:" + str(HOME / ".local/bin") + ":" + str(HOME / ".hermes/bin")
                   + ":/usr/bin:/bin:/usr/sbin:/sbin"}
    try:
        r = subprocess.run([HERMES, "-z", prompt], capture_output=True, text=True, timeout=300, env=env)
    except Exception as e:
        log(f"summarize call failed: {e}")
        return None
    m = re.search(r"<!--INBOX-->(.*?)<!--/INBOX-->", r.stdout or "", re.S)
    if not m:
        log("summarize returned no INBOX block")
        return None
    try:
        out = json.loads(re.sub(r"```json|```", "", m.group(1)).strip())
        return {o.get("n"): o.get("line", "") for o in out if isinstance(o, dict)}
    except Exception:
        log("summarize returned unparseable JSON")
        return None


def _dotenv(key):
    try:
        for line in (HOME / ".hermes/.env").read_text().splitlines():
            if line.startswith(key + "="):
                return line.split("=", 1)[1].strip().strip('"').strip("'")
    except OSError:
        pass
    return ""


def format_post(items, lines):
    replies = sum(1 for it in items if it["reply_to_agent"])
    head = f"📥 *the agent's inbox — {len(items)} new message{'s' if len(items) != 1 else ''}*"
    if replies:
        head += f" ({replies} in reply to something I sent)"
    out = [head]
    for i, it in enumerate(items, 1):
        tag = "↩️ " if it["reply_to_agent"] else ""
        out.append(f"{i}. {tag}*{it['from_name']}* — _{it['subject'][:80]}_")
        line = (lines or {}).get(i)
        out.append(f"    {line.strip() if line else it['body'][:140].replace(chr(10), ' ')}")
    return "\n".join(out)


def post(text):
    channel = _dotenv("SLACK_HOME_CHANNEL")
    if not channel:
        raise RuntimeError("no SLACK_HOME_CHANNEL in ~/.hermes/.env")
    subprocess.run([HERMES, "send", "-t", f"slack:{channel}", text],
                   capture_output=True, text=True, timeout=60, check=True)


def main(dry_run=False):
    state = load_state()
    service = google_api.build_service("gmail", "v1")
    items = fetch_new(service, state["seen"])
    if not items:
        log("nothing new in the agent's mailbox inbox")
        return
    lines = summarize(items)
    text = format_post(items, lines)
    if dry_run:
        print(text)
        log(f"DRY RUN — {len(items)} new, summary={'ok' if lines else 'FAILED'}; state untouched")
        return
    post(text)
    now = datetime.datetime.now(datetime.timezone.utc).isoformat()
    for it in items:
        state["seen"][it["message_id"]] = now
    save_state(state)
    log(f"posted {len(items)} new message(s) to the home Slack channel "
        f"({sum(1 for it in items if it['reply_to_agent'])} replies to {{AGENT_NAME}}); "
        f"summary={'ok' if lines else 'FAILED — raw subjects posted'}")


if __name__ == "__main__":
    try:
        main(dry_run="--dry-run" in sys.argv)
    except Exception as e:
        log(f"ERROR {type(e).__name__}: {e}")
        sys.exit(1)

#!/bin/sh
# TEMPLATE — no placeholders; install to ~/.local/bin/python (chmod +x). Hermes v0.22+ only.
#
# The Python every script, skill and launchd job here runs on. Hermes v0.22 keeps its Python and
# packages under its own package manager, in a dependency "generation" whose path changes on every
# update, so nothing may hard-code it. This wrapper finds the interpreter the same way Hermes does:
# ~/.local/bin/hermes is a one-line `exec <launcher> "$@"`, and that launcher's second line execs the
# package manager's Python. Then `import hermes_bootstrap` activates the selected generation.
# (On v0.21.x and older, ~/.local/bin/python is instead a plain symlink to the platform venv's python.)
LAUNCHER=$(sed -n 's/^exec "\{0,1\}\([^" ]*\)"\{0,1\} .*/\1/p' "$HOME/.local/bin/hermes" | head -1)
PY=$(sed -n '2s/^exec \([^ ]*\) .*/\1/p' "$LAUNCHER" 2>/dev/null)
CHECKOUT=$(dirname "$(dirname "$(dirname "$LAUNCHER")")")
[ -x "$PY" ] || { echo "python wrapper: cannot resolve Hermes's interpreter via $HOME/.local/bin/hermes" >&2; exit 127; }
exec "$PY" -I -c '
import os, sys, runpy
checkout = sys.argv.pop(1)
for k in ("PYTHONHOME", "PYTHONPATH", "VIRTUAL_ENV"):
    os.environ.pop(k, None)
sys.path.insert(0, checkout)
sys._hermes_pin_default_home = True
import hermes_bootstrap
# Children launched via sys.executable must get this same environment, not the bare interpreter.
sys.executable = os.path.expanduser("~/.local/bin/python")
os.environ.setdefault("HERMES_HOME", os.path.expanduser("~/.hermes"))
args = sys.argv[1:]
if not args:
    sys.exit("usage: python script.py [args] | python -m module [args] | python -c code [args]")
if args[0] == "-m":
    sys.argv = [args[1]] + args[2:]
    sys.path.insert(0, os.getcwd())
    runpy.run_module(args[1], run_name="__main__", alter_sys=True)
elif args[0] == "-c":
    sys.argv = ["-c"] + args[2:]
    sys.path.insert(0, "")
    exec(compile(args[1], "<string>", "exec"), {"__name__": "__main__"})
else:
    script = os.path.abspath(args[0])
    sys.argv = [script] + args[1:]
    sys.path.insert(0, os.path.dirname(script))
    runpy.run_path(script, run_name="__main__")
' "$CHECKOUT" "$@"

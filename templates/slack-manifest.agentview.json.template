{
  "display_information": {
    "name": "{{AGENT_NAME}}",
    "description": "Your Hermes agent on Slack",
    "background_color": "#1a1a2e"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "{{AGENT_NAME}}",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/agents",
        "url": "https://hermes-agent.local/slack/commands",
        "description": "Show active agents and running tasks",
        "should_escape": false
      },
      {
        "command": "/approve",
        "url": "https://hermes-agent.local/slack/commands",
        "description": "Approve a pending dangerous command",
        "usage_hint": "[session|always]",
        "should_escape": false
      },
      {
        "command": "/background",
        "url": "https://hermes-agent.local/slack/commands",
        "description": "Run a prompt in the background",
        "usage_hint": "<prompt>",
        "should_escape": false
      },
      {
        "command": "/backup-status",
        "url": "https://hermes-agent.local/slack/commands",
        "description": "Nightly backup log + latest bundles",
        "should_escape": false
      },
      {
        "command": "/bg",
        "url": "https://hermes-agent.local/slack/commands",
        "description": "Alias for /background \u2014 Run a prompt in the background",
        "usage_hint": "<prompt>",
        "should_escape": false
      },
      {
        "command": "/btw",
        "url": "https://hermes-agent.local/slack/commands",
        "description": "Alias for /background \u2014 Run a prompt in the background",
        "usage_hint": "<prompt>",
        "should_escape": false
      },
      {
        "command": "/commands",
        "url": "https://hermes-agent.local/slack/commands",
        "description": "Browse all commands and skills (paginated)",
        "usage_hint": "[page]",
        "should_escape": false
      },
      {
        "command": "/compress",
        "url": "https://hermes-agent.local/slack/commands",
        "description": "Compress conversation context (add 'here [N]' to keep recent N turns; --preview shows what would happen)",
        "usage_hint": "[here [N] | focus topic | --preview|--dry-run]",
        "should_escape": false
      },
      {
        "command": "/deny",
        "url": "https://hermes-agent.local/slack/commands",
        "description": "Deny a pending dangerous command (optionally with a reason)",
        "usage_hint": "[all] [reason]",
        "should_escape": false
      },
      {
        "command": "/fast",
        "url": "https://hermes-agent.local/slack/commands",
        "description": "Toggle fast mode \u2014 OpenAI Priority Processing / Anthropic Fast Mode (Normal/Fast)",
        "usage_hint": "[normal|fast|status] [--global]",
        "should_escape": false
      },
      {
        "command": "/goal",
        "url": "https://hermes-agent.local/slack/commands",
        "description": "Set a standing goal Hermes works on across turns until achieved",
        "usage_hint": "[text | draft <text> | show | pause | resume | clear | status | wait <pid> | unwait]",
        "should_escape": false
      },
      {
        "command": "/help",
        "url": "https://hermes-agent.local/slack/commands",
        "description": "Show available commands",
        "should_escape": false
      },
      {
        "command": "/hermes",
        "url": "https://hermes-agent.local/slack/commands",
        "description": "Talk to Hermes or run a subcommand",
        "usage_hint": "[subcommand] [args]",
        "should_escape": false
      },
      {
        "command": "/insights",
        "url": "https://hermes-agent.local/slack/commands",
        "description": "Show usage insights and analytics",
        "usage_hint": "[days]",
        "should_escape": false
      },
      {
        "command": "/jobs",
        "url": "https://hermes-agent.local/slack/commands",
        "description": "launchd job status (ai.hermes.*)",
        "should_escape": false
      },
      {
        "command": "/memory",
        "url": "https://hermes-agent.local/slack/commands",
        "description": "Review pending memory writes / toggle the approval gate",
        "usage_hint": "[pending|approve|reject|approval] [id|on|off]",
        "should_escape": false
      },
      {
        "command": "/model",
        "url": "https://hermes-agent.local/slack/commands",
        "description": "Switch model (session-scoped; --global to persist)",
        "usage_hint": "[model] [--provider name] [--global|--session] [--refresh]",
        "should_escape": false
      },
      {
        "command": "/new",
        "url": "https://hermes-agent.local/slack/commands",
        "description": "Start a new session (fresh session ID + history)",
        "usage_hint": "[name]",
        "should_escape": false
      },
      {
        "command": "/profile",
        "url": "https://hermes-agent.local/slack/commands",
        "description": "Show active profile name and home directory",
        "should_escape": false
      },
      {
        "command": "/queue",
        "url": "https://hermes-agent.local/slack/commands",
        "description": "Queue a prompt for the next turn (doesn't interrupt)",
        "usage_hint": "<prompt>",
        "should_escape": false
      },
      {
        "command": "/reasoning",
        "url": "https://hermes-agent.local/slack/commands",
        "description": "Manage reasoning effort and display",
        "usage_hint": "[level|show|hide|full|clamp] [--global]",
        "should_escape": false
      },
      {
        "command": "/reload-mcp",
        "url": "https://hermes-agent.local/slack/commands",
        "description": "Reload MCP servers from config",
        "should_escape": false
      },
      {
        "command": "/reload-skills",
        "url": "https://hermes-agent.local/slack/commands",
        "description": "Re-scan ~/.hermes/skills/ for newly installed or removed skills",
        "should_escape": false
      },
      {
        "command": "/reminders",
        "url": "https://hermes-agent.local/slack/commands",
        "description": "List scheduled one-shot reminders",
        "should_escape": false
      },
      {
        "command": "/restart",
        "url": "https://hermes-agent.local/slack/commands",
        "description": "Gracefully restart the gateway after draining active runs",
        "should_escape": false
      },
      {
        "command": "/resume",
        "url": "https://hermes-agent.local/slack/commands",
        "description": "Resume a previously-named session",
        "usage_hint": "[name]",
        "should_escape": false
      },
      {
        "command": "/retry",
        "url": "https://hermes-agent.local/slack/commands",
        "description": "Retry the last message (resend to agent)",
        "should_escape": false
      },
      {
        "command": "/sessions",
        "url": "https://hermes-agent.local/slack/commands",
        "description": "Browse and resume previous sessions",
        "should_escape": false
      },
      {
        "command": "/sethome",
        "url": "https://hermes-agent.local/slack/commands",
        "description": "Set this chat as the home channel",
        "should_escape": false
      },
      {
        "command": "/skills",
        "url": "https://hermes-agent.local/slack/commands",
        "description": "Search, install, inspect, or manage skills",
        "should_escape": false
      },
      {
        "command": "/start",
        "url": "https://hermes-agent.local/slack/commands",
        "description": "Acknowledge platform start pings without a reply",
        "should_escape": false
      },
      {
        "command": "/steer",
        "url": "https://hermes-agent.local/slack/commands",
        "description": "Inject a message after the next tool call without interrupting",
        "usage_hint": "<prompt>",
        "should_escape": false
      },
      {
        "command": "/stop",
        "url": "https://hermes-agent.local/slack/commands",
        "description": "Kill all running background processes",
        "should_escape": false
      },
      {
        "command": "/undo",
        "url": "https://hermes-agent.local/slack/commands",
        "description": "Back up N user turns and re-prompt (default 1)",
        "usage_hint": "[N]",
        "should_escape": false
      },
      {
        "command": "/usage",
        "url": "https://hermes-agent.local/slack/commands",
        "description": "Show token usage and rate limits; `reset` redeems a banked Codex limit reset",
        "usage_hint": "[reset [--force]]",
        "should_escape": false
      },
      {
        "command": "/voice",
        "url": "https://hermes-agent.local/slack/commands",
        "description": "Toggle voice mode",
        "usage_hint": "[on|off|tts|status]",
        "should_escape": false
      },
      {
        "command": "/whoami",
        "url": "https://hermes-agent.local/slack/commands",
        "description": "Show your slash command access (admin / user)",
        "should_escape": false
      }
    ],
    "agent_view": {
      "agent_description": "Chat with Hermes in Slack Messages.",
      "suggested_prompts": []
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "assistant:write",
        "channels:history",
        "channels:read",
        "chat:write",
        "commands",
        "files:read",
        "files:write",
        "groups:history",
        "groups:read",
        "im:history",
        "im:read",
        "im:write",
        "mpim:history",
        "mpim:read",
        "reactions:read",
        "users:read"
      ]
    },
    "pkce_enabled": false
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_context_changed",
        "app_home_opened",
        "app_mention",
        "message.channels",
        "message.groups",
        "message.im",
        "message.mpim",
        "reaction_added",
        "reaction_removed"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false,
    "is_mcp_enabled": false
  }
}
